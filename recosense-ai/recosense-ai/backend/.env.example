# ---- RecoSense AI backend configuration (copy to .env) ----
ENV=development                      # development | production | test
DATABASE_URL=postgresql+psycopg://recosense:recosense@localhost:5432/recosense
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_MB=25
# Default hybrid recommendation weights (admin can override at runtime)
REC_WEIGHT_CONTENT=0.35
REC_WEIGHT_COLLABORATIVE=0.30
REC_WEIGHT_SENTIMENT=0.25
REC_WEIGHT_RATING=0.10
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
